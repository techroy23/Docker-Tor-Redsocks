FROM alpine:latest

RUN apk update && apk add --no-cache \
    bash curl wget iptables redsocks tor \
    shadow gosu coreutils ca-certificates dos2unix socat \
  && rm -rf /var/cache/apk/*

WORKDIR /app
COPY *.sh /app/
RUN dos2unix /app/*.sh && chmod +x /app/*.sh

RUN adduser -D -s /bin/sh toruser \
 && mkdir -p /var/lib/tor /var/log/tor \
 && chown -R toruser:toruser /var/lib/tor /var/log/tor /etc/tor

# Configure Tor
RUN echo "SocksPort 40000" > /etc/tor/torrc \
 && echo "DataDirectory /var/lib/tor" >> /etc/tor/torrc \
 && chown toruser:toruser /etc/tor/torrc

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD timeout 3 bash -c 'echo >/dev/tcp/127.0.0.1/40000' 2>/dev/null || exit 1

ENTRYPOINT ["/bin/bash"]
